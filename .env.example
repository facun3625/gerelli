DATABASE_URL="postgresql://pedidos:pedidos@localhost:5452/pedidos?schema=public"

# Dominio raíz de la plataforma, SIN el subdominio de tenant (ej: "pedidos.app"
# en prod, "localhost:3010" en local). Sirve para: 1) que el middleware
# detecte qué parte del host es el subdominio de la tienda, y 2) que el login
# con Google use SIEMPRE este dominio como redirect URI, sin importar desde
# qué subdominio de tienda arrancó el login (ver src/auth.ts).
ROOT_DOMAIN="localhost:3010"

# Auth.js (NextAuth v5) - generar un valor real con: npx auth secret
AUTH_SECRET="dev-secret-change-me"

# Google OAuth (crear credenciales en https://console.cloud.google.com/apis/credentials).
# El único redirect URI a registrar en Google Cloud Console es:
#   http(s)://<ROOT_DOMAIN>/api/auth/callback/google
# (nunca el subdominio de una tienda puntual — Auth.js redirige internamente
# de vuelta a la tienda de origen después de confirmar con Google).
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Cobro de las suscripciones de Urbi. Son secretos del servidor: nunca deben
# usar el prefijo NEXT_PUBLIC_ ni enviarse al navegador.
MERCADOPAGO_PLATFORM_ACCESS_TOKEN=""
MERCADOPAGO_PLATFORM_WEBHOOK_SECRET=""

# Protege /api/cron/billing (vencimientos y períodos de gracia) y también
# /api/cron/backup (backup diario de la base).
CRON_SECRET=""

# Mercado Pago rechaza localhost como back_url. Para pruebas locales podés
# colocar acá la URL HTTPS de un túnel; si queda vacío, se usa urbi.com.ar.
MERCADOPAGO_TEST_BACK_URL=""

# Asistente de ventas con IA (src/lib/sales-bot.ts, src/app/api/estate-ai).
# Generar en https://aistudio.google.com/apikey. Sin esto, el agente de IA
# no responde aunque el tenant lo tenga activado (ver ai_agent_enabled en
# Settings).
GEMINI_API_KEY=""

# Cloudflare R2 (almacenamiento de imágenes/videos de propiedades) — bucket
# "inmobiliarias". Token: R2 > Manage API Tokens > Account API Token con
# permiso Object Read & Write, scope a este bucket.
R2_ENDPOINT=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_PUBLIC_URL=""

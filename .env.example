DATABASE_URL="postgresql://gerelli:gerelli@localhost:5462/gerelli?schema=public"

# App de un solo dominio, sin subdominios de tenant.
ROOT_DOMAIN="localhost:3011"

# Auth.js (NextAuth v5) - generar un valor real con: npx auth secret
AUTH_SECRET="dev-secret-change-me"

# Google OAuth (crear credenciales en https://console.cloud.google.com/apis/credentials).
# Redirect URI a registrar en Google Cloud Console:
#   http(s)://<ROOT_DOMAIN>/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Protege /api/cron/estate-billing y /api/cron/backup.
CRON_SECRET=""

# Resend (mails transaccionales: recuperar contraseña, consultas, etc.)
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""

# Cloudflare R2 (almacenamiento de imágenes/videos de propiedades).
R2_ENDPOINT=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_PUBLIC_URL=""

# El agente de ventas IA (proveedor, modelo y API key de OpenAI o Gemini) se
# configura desde /admin/configuracion → Agente IA, no por variable de
# entorno — queda guardado en Settings.
